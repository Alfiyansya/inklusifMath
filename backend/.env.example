# =============================================================================
# InklusifMath Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
#
# Required for basic run:  DATABASE_URL, FIREBASE_PROJECT_ID
# Required for AI:         GEMINI_API_KEY
# Required for OCR:        GOOGLE_APPLICATION_CREDENTIALS (or GCV_OCR_ENABLED=false)
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=InklusifMath API
DEBUG=false                          # Set true in development for verbose logs

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inklusifmath

# Run with Docker:  docker compose up -d db
# Apply migrations: alembic upgrade head

# -----------------------------------------------------------------------------
# Redis (Rate Limiting + Celery)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Run with Docker: docker compose up -d redis

# -----------------------------------------------------------------------------
# Firebase Admin SDK (required)
# -----------------------------------------------------------------------------
# Project ID from Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service Account JSON — one of these two methods:
#   Method A (recommended for production): set path to service account file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   Method B (for local dev): base64-encoded JSON in env var
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of service-account.json>

# -----------------------------------------------------------------------------
# AI — Google Gemini (required for AI narration + Socratic tutor)
# -----------------------------------------------------------------------------
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash        # or gemini-1.5-pro for higher quality

# -----------------------------------------------------------------------------
# OCR — Google Cloud Vision (optional, for scanned PDFs)
# -----------------------------------------------------------------------------
# Enable/disable GCV OCR. Set false to skip OCR entirely.
GCV_OCR_ENABLED=true
# Uses GOOGLE_APPLICATION_CREDENTIALS above (same service account)
# Required IAM role: Cloud Vision API User

# -----------------------------------------------------------------------------
# OCR — Mathpix (optional, for math formula image → LaTeX)
# -----------------------------------------------------------------------------
# Get credentials: https://mathpix.com/
MATHPIX_ENABLED=true
MATHPIX_APP_ID=your-mathpix-app-id
MATHPIX_APP_KEY=your-mathpix-app-key

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20                # Max upload size in MB (default 20)
UPLOAD_DIR=uploads                   # Relative path to store uploaded files

# Note: For production, replace local disk storage with GCS or S3.
#       See item 12.3 in implementation_checklist.md.

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]
# Production example:
# CORS_ORIGINS=["https://inklusifmath.id","https://www.inklusifmath.id"]

# -----------------------------------------------------------------------------
# STT — faster-whisper (optional fallback for Firefox users)
# -----------------------------------------------------------------------------
# Whisper runs locally — no API key needed.
# Model is downloaded automatically on first use.
# Set to a valid faster-whisper model name:
WHISPER_MODEL=tiny                   # tiny | base | small | medium | large-v3
# Primary STT is Web Speech API (browser-native, zero config needed).

# -----------------------------------------------------------------------------
# JWT (kept for backward compat — Firebase Auth is the actual auth mechanism)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE-ME-use-a-long-random-string-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
